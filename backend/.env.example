# DevLens AI - Backend Environment Configuration
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Optional: GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
# Generate at: https://github.com/settings/tokens (No special permissions needed for public repos)
GITHUB_TOKEN=

# AI LLM Provider Configuration
# Supported providers: "gemini" (recommended, free tier at https://aistudio.google.com/) or "openai"
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Alternative OpenAI config (if LLM_PROVIDER=openai):
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
